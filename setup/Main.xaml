<!-- Triforce Setup's window. Loaded at run time (XamlReader): no x:Class, the code finds the named parts and wires them.
     The look: a relic in a dark hall. Near-black, one warm light, the painted crest on the right with its three stones lit or
     unlit as the work goes (Stage.cs builds that side into StageHost), the page's words and controls on the left. Gold is an
     accent (labels, hairlines, the one main button), titles are parchment white. Tokens: Look.cs (Fx) and the lab's style_tokens.md.
     One composed size, 1060 x 640: Shell scales the whole picture down on a screen too small for it. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:t="clr-namespace:TriforceSetup;assembly=TriforceSetup"
        Title="Triforce Setup" Width="1060" Height="640"
        WindowStartupLocation="CenterScreen" AllowDrop="True" ResizeMode="CanMinimize"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        Background="#0A0908" Foreground="#CDC2A8" FontFamily="Segoe UI" FontSize="14">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- the hall -->
    <SolidColorBrush x:Key="Ink900" Color="#0A0908"/>
    <SolidColorBrush x:Key="Ink800" Color="#12100C"/>
    <SolidColorBrush x:Key="Ink700" Color="#1B1711"/>
    <SolidColorBrush x:Key="Ink600" Color="#262017"/>
    <SolidColorBrush x:Key="Line" Color="#2C2518"/>
    <SolidColorBrush x:Key="LineStrong" Color="#40361F"/>
    <SolidColorBrush x:Key="LineGold" Color="#47E0B23E"/>
    <SolidColorBrush x:Key="LineGoldHi" Color="#99E0B23E"/>
    <!-- parchment -->
    <SolidColorBrush x:Key="TextHi" Color="#F3EAD5"/>
    <SolidColorBrush x:Key="Text" Color="#CDC2A8"/>
    <SolidColorBrush x:Key="TextDim" Color="#948A70"/>
    <SolidColorBrush x:Key="TextFaint" Color="#5F5744"/>
    <!-- gold, and the two colours of news -->
    <SolidColorBrush x:Key="Gold100" Color="#FFF4CC"/>
    <SolidColorBrush x:Key="Gold300" Color="#F7DC8C"/>
    <SolidColorBrush x:Key="Gold" Color="#E0B23E"/>
    <SolidColorBrush x:Key="Gold900" Color="#3D2A08"/>
    <SolidColorBrush x:Key="Good" Color="#6BE07F"/>
    <SolidColorBrush x:Key="Bad" Color="#FF6B76"/>
    <LinearGradientBrush x:Key="GoldBar" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Offset="0" Color="#FFF4CC"/><GradientStop Offset="0.12" Color="#F7DC8C"/><GradientStop Offset="0.48" Color="#E0B23E"/><GradientStop Offset="1" Color="#9A6A18"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoldBarHot" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Offset="0" Color="#FFFBEA"/><GradientStop Offset="0.14" Color="#FBE7A6"/><GradientStop Offset="0.5" Color="#ECC251"/><GradientStop Offset="1" Color="#A9761C"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Fading" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Offset="0" Color="#47E0B23E"/><GradientStop Offset="0.7" Color="#2CE0B23E"/><GradientStop Offset="1" Color="#00E0B23E"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Sheen" StartPoint="0,1" EndPoint="1,0">
      <GradientStop Offset="0.3" Color="#00FFFFFF"/><GradientStop Offset="0.5" Color="#8CFFFFFF"/><GradientStop Offset="0.7" Color="#00FFFFFF"/>
    </LinearGradientBrush>
    <FontFamily x:Key="Serif">Palatino Linotype, Book Antiqua, Georgia</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

    <!-- words -->
    <Style x:Key="Eyebrow" TargetType="t:Caps">
      <Setter Property="Gaps" Value="1"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="t:Caps" BasedOn="{StaticResource Eyebrow}">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Serif}"/>
      <Setter Property="FontSize" Value="32"/>
      <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="38"/>
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
      <Setter Property="Margin" Value="-1,14,0,0"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="22"/>
      <Setter Property="MaxWidth" Value="540"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="Small" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="19"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="21"/>
    </Style>
    <Style x:Key="Diamond" TargetType="Rectangle">
      <Setter Property="Width" Value="7"/>
      <Setter Property="Height" Value="7"/>
      <Setter Property="Fill" Value="{StaticResource Gold}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="45"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="Hair" TargetType="Rectangle">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Fill" Value="{StaticResource Line}"/>
    </Style>

    <!-- the one main button of a page: a bar of gold -->
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Height" Value="44"/>
      <Setter Property="MinWidth" Value="176"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Glow" CornerRadius="3" Background="#E0B23E" Opacity="0.16" Margin="-1">
                <Border.Effect><BlurEffect Radius="16"/></Border.Effect>
              </Border>
              <Border x:Name="Ring" CornerRadius="4" BorderBrush="#B3FFF4CC" BorderThickness="1" Margin="-4" Opacity="0"/>
              <Border x:Name="Face" CornerRadius="2" Background="{StaticResource GoldBar}" ClipToBounds="True">
                <Grid>
                  <Rectangle x:Name="Top" Height="1" VerticalAlignment="Top" Fill="#A6FFFFFF"/>
                  <Rectangle x:Name="Foot" Height="1" VerticalAlignment="Bottom" Fill="#663D2A08"/>
                  <Rectangle x:Name="Sheen" Width="110" HorizontalAlignment="Left" Fill="{StaticResource Sheen}" Opacity="0">
                    <Rectangle.RenderTransform><TranslateTransform X="-120"/></Rectangle.RenderTransform>
                  </Rectangle>
                  <t:Caps x:Name="Words" Label="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Gaps="2"
                          FontFamily="{StaticResource Serif}" FontWeight="Bold" FontSize="13" Foreground="#2A1C05"
                          TextOptions.TextFormattingMode="Ideal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28,0,28,1">
                    <t:Caps.Effect><DropShadowEffect Color="#FFF4CC" BlurRadius="0" ShadowDepth="1" Direction="270" Opacity="0.45"/></t:Caps.Effect>
                  </t:Caps>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{StaticResource GoldBarHot}"/>
                <Setter TargetName="Sheen" Property="Opacity" Value="1"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-120" To="340" Duration="0:0:0.7"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.16" Duration="0:0:0.22"/></Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Opacity" Value="0.86"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Background" Value="{StaticResource Ink600}"/>
                <Setter TargetName="Glow" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Top" Property="Fill" Value="#14FFFFFF"/>
                <Setter TargetName="Foot" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Words" Property="Effect" Value="{x:Null}"/>
                <Setter TargetName="Words" Property="Foreground" Value="{StaticResource TextFaint}"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- every other button: a hairline frame -->
    <Style x:Key="Quiet" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" CornerRadius="2" Background="#00000000" BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource LineGoldHi}"/>
                <Setter TargetName="Face" Property="Background" Value="{StaticResource Ink800}"/>
                <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Gold}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{StaticResource Ink700}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- a way to somewhere else: gold words and a small arrow -->
    <Style x:Key="Link" TargetType="ButtonBase">
      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <StackPanel Orientation="Horizontal" Background="#00000000">
              <ContentPresenter Margin="0,5" VerticalAlignment="Center"/>
              <Path x:Name="Arrow" Data="M0,0 L3.5,3.5 L0,7" StrokeThickness="1.3" Margin="8,1,0,0" VerticalAlignment="Center"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}">
                <Path.RenderTransform><TranslateTransform/></Path.RenderTransform>
              </Path>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Gold300}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="3" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.22"/></Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource Gold100}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Caption" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="#00000000">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{StaticResource Ink700}"/>
                <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Caption}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="#00000000">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="#8E1622"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- wells: where a path is typed, where the build's details scroll -->
    <Style x:Key="Path" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Gold300}"/>
      <Setter Property="SelectionBrush" Value="#E0B23E"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="B" CornerRadius="2" Background="#CC12100C" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,0">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource LineStrong}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource LineGoldHi}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- one of two ways (a file or folders; into or out of): words with a gold line under the chosen one -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="22,0,0,0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="#00000000">
              <ContentPresenter Margin="0,0,0,8"/>
              <Rectangle x:Name="Bar" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource Gold}" Opacity="0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource Gold300}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Tick" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="#00000000">
              <Border x:Name="Box" Width="16" Height="16" CornerRadius="2" Background="#CC12100C" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" VerticalAlignment="Center">
                <Path x:Name="Mark" Data="M3,7.6 L6.2,10.8 L11.6,4.2" Stroke="#2A1C05" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="12,0,0,1" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource GoldBar}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Gold300}"/>
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource LineGoldHi}"/>
                <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Choice" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="B" CornerRadius="2" Background="#CC12100C" BorderBrush="{StaticResource Line}" BorderThickness="1">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Gold}" StrokeThickness="1.3"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource LineGoldHi}"/></Trigger>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource LineGoldHi}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Margin="12,0,30,1" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                     IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300" CornerRadius="2"
                        Background="#12100C" BorderBrush="{StaticResource LineGoldHi}" BorderThickness="1" Padding="3">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="B" CornerRadius="2" Padding="10,6" Background="#00000000"><ContentPresenter/></Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                      <Setter TargetName="B" Property="Background" Value="{StaticResource Ink600}"/>
                      <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Gold300}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- scroll bars: a thin thumb, nothing else (Windows' own grey ones have no place in the hall) -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="T" CornerRadius="2" Background="#4A3F28" Margin="2"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#8A6A22"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="#E0B23E"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="#00000000"/></ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="9"/>
      <Setter Property="MinWidth" Value="9"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="9"/>
          <Setter Property="MinHeight" Value="9"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track">
                  <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                  <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                  <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="#12100C" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="2" Padding="9,5">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- Host is the window's inside as Windows gives it; Root is the picture, always 1060 x 640 (Shell.FitToScreen keeps the two
       the same size; Root is not indented a level deeper to keep the pages readable) -->
  <Grid x:Name="Host">
  <Grid x:Name="Root" Width="1060" Height="640" HorizontalAlignment="Left" VerticalAlignment="Top">
    <!-- the hall and the relic (Stage.cs) -->
    <Grid x:Name="StageHost"/>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="630"/><ColumnDefinition Width="430"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <!-- caption -->
      <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
        <t:Caps Label="Triforce Setup" Style="{StaticResource Eyebrow}" FontSize="9.5" Foreground="{StaticResource TextFaint}"/>
        <TextBlock x:Name="VersionText" Margin="14,0,0,1" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource TextFaint}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="MinButton" Style="{StaticResource Caption}" ToolTip="Minimize">
          <Rectangle Width="10" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
        <Button x:Name="CloseButton" Style="{StaticResource CaptionClose}" ToolTip="Close">
          <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
      </StackPanel>

      <!-- page: install -->
      <Grid x:Name="InstallPage" Grid.Row="1" Margin="56,22,34,36" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Rectangle Width="20" Height="1" Fill="{StaticResource LineGoldHi}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <t:Caps Label="I · Install" Style="{StaticResource Eyebrow}"/>
          </StackPanel>
          <TextBlock Text="Welcome, hero." Style="{StaticResource Title}"/>
          <TextBlock Style="{StaticResource Body}" Margin="0,12,0,0"
                     Text="Triforce turns your own copy of Ocarina of Time into a native PC game. Setup installs itself, fetches the Triforce tools, and keeps everything up to date for you."/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,34,0,0">
          <t:Caps Label="Install Triforce to" Style="{StaticResource FieldLabel}" Margin="0,0,0,10"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="InstallPath" Style="{StaticResource Path}"/>
            <Button x:Name="BrowseInstall" Grid.Column="1" Style="{StaticResource Quiet}" Height="38" Margin="8,0,0,0" Content="Browse"/>
          </Grid>
          <TextBlock x:Name="InstallSpace" Style="{StaticResource Small}" Margin="0,10,0,26"/>
          <CheckBox x:Name="DesktopIcon" Style="{StaticResource Tick}" IsChecked="True" Content="Put Triforce on the desktop"/>
          <CheckBox x:Name="StartIcon" Style="{StaticResource Tick}" IsChecked="True" Content="Add Triforce to the Start menu"/>
        </StackPanel>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,20,0"
                     Text="No game data is downloaded: you bring your own copy."/>
          <Button x:Name="InstallButton" Grid.Column="1" Style="{StaticResource Primary}" Content="Install"/>
        </Grid>
      </Grid>

      <!-- page: gathering (the update check, downloads) -->
      <Grid x:Name="FetchPage" Grid.Row="1" Margin="56,22,34,36" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Rectangle Width="20" Height="1" Fill="{StaticResource LineGoldHi}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <t:Caps Label="II · Gather" Style="{StaticResource Eyebrow}"/>
          </StackPanel>
          <TextBlock x:Name="FetchTitle" Style="{StaticResource Title}" Text="Gathering the stones"/>
          <TextBlock x:Name="FetchNote" Style="{StaticResource Body}" Margin="0,12,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,0">
          <StackPanel x:Name="FetchNumberRow" Orientation="Horizontal" Height="70" Visibility="Hidden">
            <TextBlock x:Name="FetchNumber" FontFamily="{StaticResource Serif}" FontSize="64" Foreground="{StaticResource TextHi}"
                       TextOptions.TextFormattingMode="Ideal" VerticalAlignment="Bottom" Margin="-3,0,0,-8"/>
            <TextBlock Text="%" FontFamily="{StaticResource Serif}" FontSize="24" Foreground="{StaticResource Gold}"
                       TextOptions.TextFormattingMode="Ideal" VerticalAlignment="Bottom" Margin="6,0,0,4"/>
          </StackPanel>
          <t:ProgressLine x:Name="FetchBar" Margin="0,14,0,0"/>
          <Grid Margin="0,8,0,0">
            <TextBlock x:Name="FetchStep" Style="{StaticResource Small}" Foreground="{StaticResource Text}"/>
            <TextBlock x:Name="FetchPercent" Style="{StaticResource Small}" HorizontalAlignment="Right"/>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Height="44">
          <Button x:Name="FetchSkip" Style="{StaticResource Quiet}" Height="44" Content="Continue offline" Visibility="Collapsed" Margin="0,0,12,0"/>
          <Button x:Name="FetchCancel" Style="{StaticResource Quiet}" Height="44" Content="Cancel"/>
          <Button x:Name="FetchRetry" Style="{StaticResource Primary}" Content="Try again" Visibility="Collapsed" Margin="12,0,0,0"/>
        </StackPanel>
      </Grid>

      <!-- page: welcome back (every start once there is something to play or to build with): play, or the update first -->
      <Grid x:Name="HomePage" Grid.Row="1" Margin="56,22,34,36" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Rectangle Width="20" Height="1" Fill="{StaticResource LineGoldHi}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <t:Caps x:Name="HomeEyebrow" Label="IV · Play" Style="{StaticResource Eyebrow}"/>
          </StackPanel>
          <TextBlock x:Name="HomeTitle" Style="{StaticResource Title}" FontSize="40" LineHeight="46" Text="Welcome back, hero."/>
          <TextBlock x:Name="HomeNote" Style="{StaticResource Body}" Margin="0,12,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,30,0,0">
          <Rectangle Style="{StaticResource Hair}" Fill="{StaticResource Fading}"/>
          <Grid Margin="0,13,0,13">
            <Grid.ColumnDefinitions><ColumnDefinition Width="172"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="1,5,0,0">
              <Rectangle x:Name="GameMark" Style="{StaticResource Diamond}"/>
              <t:Caps Label="Your game" Style="{StaticResource FieldLabel}" Margin="12,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="GameLine" Style="{StaticResource Value}"/>
              <TextBlock x:Name="GamePath" Style="{StaticResource Small}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
            </StackPanel>
          </Grid>
          <Rectangle Style="{StaticResource Hair}" Fill="{StaticResource Fading}"/>
          <Grid Margin="0,13,0,13">
            <Grid.ColumnDefinitions><ColumnDefinition Width="172"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="1,5,0,0">
              <Rectangle x:Name="SavesMark" Style="{StaticResource Diamond}"/>
              <t:Caps Label="Your saves" Style="{StaticResource FieldLabel}" Margin="12,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,16,0">
              <TextBlock x:Name="SavesLine" Style="{StaticResource Value}"/>
              <TextBlock x:Name="SavesDetail" Style="{StaticResource Small}" Margin="0,1,0,0"/>
            </StackPanel>
            <Button x:Name="ConvertSavesButton" Grid.Column="2" Style="{StaticResource Link}" Content="Convert saves" VerticalAlignment="Top" Margin="0,-3,0,-5"/>
          </Grid>
          <Rectangle Style="{StaticResource Hair}" Fill="{StaticResource Fading}"/>
          <Grid Margin="0,13,0,13">
            <Grid.ColumnDefinitions><ColumnDefinition Width="172"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="1,5,0,0">
              <Rectangle x:Name="NewsMark" Style="{StaticResource Diamond}"/>
              <t:Caps Label="Newest Triforce" Style="{StaticResource FieldLabel}" Margin="12,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="NewsLine" Style="{StaticResource Value}"/>
              <TextBlock x:Name="NewsDetail" Style="{StaticResource Small}" Margin="0,1,0,0"/>
            </StackPanel>
          </Grid>
          <Rectangle Style="{StaticResource Hair}" Fill="{StaticResource Fading}"/>
          <TextBlock x:Name="MergeNote" Style="{StaticResource Small}" Margin="0,14,0,0"/>
        </StackPanel>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ToggleButton x:Name="NewFolderLink" Style="{StaticResource Link}" VerticalAlignment="Center" HorizontalAlignment="Left" Content="Build a game folder"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="NotNowButton" Style="{StaticResource Quiet}" Height="48" Content="Not now" Margin="0,0,12,0"/>
            <Button x:Name="HomeGoButton" Style="{StaticResource Primary}" Height="48" MinWidth="208" Content="Play"/>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- page: convert saves (Triforce, EvilOOT, Eden, yuzu, Ryujinx ... keep the same save files for this game) -->
      <Grid x:Name="SavesPage" Grid.Row="1" Margin="56,22,34,36" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Rectangle Width="20" Height="1" Fill="{StaticResource LineGoldHi}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <t:Caps Label="Saves" Style="{StaticResource Eyebrow}"/>
          </StackPanel>
          <TextBlock Text="Convert saves" Style="{StaticResource Title}"/>
          <TextBlock Style="{StaticResource Body}" Margin="0,12,0,0"
                     Text="Bring your saves from an emulator into Triforce, or take Triforce's back out. Whatever gets replaced is backed up first."/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,24,0,0">
          <StackPanel Orientation="Horizontal" Margin="-22,0,0,0">
            <RadioButton x:Name="SavesIn" Style="{StaticResource Seg}" GroupName="SaveWay" IsChecked="True" Content="Into Triforce"/>
            <RadioButton x:Name="SavesOut" Style="{StaticResource Seg}" GroupName="SaveWay" Content="Out of Triforce"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,0,0">
            <Button x:Name="SavesRescan" Style="{StaticResource Link}" Content="Look again" Margin="0,0,22,0"/>
            <Button x:Name="SavesBrowse" Style="{StaticResource Link}" Content="Choose a folder"/>
          </StackPanel>
          <Rectangle Style="{StaticResource Hair}" VerticalAlignment="Bottom"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,14,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <t:Caps x:Name="SavesListLabel" Style="{StaticResource FieldLabel}" Label="Take the saves from" Margin="0,0,0,6"/>
          <ListBox x:Name="SaveList" Grid.Row="1" Background="#00000000" BorderThickness="0" Padding="0" Margin="-1,0,0,0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Grid Background="#00000000">
                        <Border x:Name="B" Background="#00000000" Padding="16,10,12,10">
                          <ContentPresenter/>
                        </Border>
                        <Rectangle x:Name="Bar" Width="2" HorizontalAlignment="Left" Fill="{StaticResource Gold}" Opacity="0" Margin="0,8"/>
                        <Rectangle Style="{StaticResource Hair}" VerticalAlignment="Bottom"/>
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#8012100C"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="B" Property="Background" Value="#D912100C"/>
                          <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </Grid>
        <TextBlock x:Name="SavesInfo" Grid.Row="3" Style="{StaticResource Small}" Foreground="{StaticResource Text}" Margin="0,12,0,16" MinHeight="38"/>
        <Grid Grid.Row="4">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="SavesTarget" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,20,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="SavesBack" Style="{StaticResource Quiet}" Height="44" Content="Back" Margin="0,0,12,0"/>
            <Button x:Name="SavesGo" Style="{StaticResource Primary}" Content="Convert" IsEnabled="False"/>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- page: the forge (choose the game) -->
      <Grid x:Name="SetupPage" Grid.Row="1" Margin="56,22,34,36" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Rectangle Width="20" Height="1" Fill="{StaticResource LineGoldHi}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <t:Caps Label="III · Forge" Style="{StaticResource Eyebrow}"/>
            </StackPanel>
            <TextBlock x:Name="SetupTitle" Style="{StaticResource Title}" Text="Forge your game"/>
            <TextBlock x:Name="Subtitle" Style="{StaticResource Body}" Margin="0,12,0,0"/>
          </StackPanel>
          <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Width="178" Margin="0,-6,0,0">
            <t:Caps x:Name="LanguageLabel" Style="{StaticResource FieldLabel}" HorizontalAlignment="Right" Margin="0,0,0,7"/>
            <ComboBox x:Name="LanguageBox" Style="{StaticResource Choice}"/>
          </StackPanel>
        </Grid>

        <!-- the game built before: out of date (update it) or ready (play). A quiet button: this page's one gold button is Build -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Margin="0,20,0,0" CornerRadius="2" Padding="16,11,11,11" Visibility="Collapsed"
                Background="#B312100C" BorderBrush="{StaticResource LineGold}" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Rectangle Style="{StaticResource Diamond}" Fill="{StaticResource Gold300}"/>
            <TextBlock x:Name="UpdateText" Grid.Column="1" Style="{StaticResource Small}" Foreground="{StaticResource TextHi}" Margin="14,0,16,0" VerticalAlignment="Center"/>
            <Button x:Name="UpdateGameButton" Grid.Column="2" Style="{StaticResource Quiet}" MinWidth="112" Height="34" Content="Update game"/>
          </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,24,0,0">
          <Grid>
            <t:Caps x:Name="GameFilesLabel" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,2,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <RadioButton x:Name="UseNup" Style="{StaticResource Seg}" GroupName="Source" IsChecked="True"/>
              <RadioButton x:Name="UseFolders" Style="{StaticResource Seg}" GroupName="Source"/>
            </StackPanel>
          </Grid>
          <Grid x:Name="NupRow" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="NupPath" Style="{StaticResource Path}"/>
            <Button x:Name="BrowseA" Grid.Column="1" Style="{StaticResource Quiet}" Height="38" Margin="8,0,0,0"/>
          </Grid>
          <StackPanel x:Name="FolderRows" Visibility="Collapsed" Margin="0,8,0,0">
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="romfs" Style="{StaticResource Small}" VerticalAlignment="Center"/>
              <TextBox x:Name="RomfsPath" Grid.Column="1" Style="{StaticResource Path}"/>
              <Button x:Name="BrowseB" Grid.Column="2" Style="{StaticResource Quiet}" Height="38" Margin="8,0,0,0"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="exefs" Style="{StaticResource Small}" VerticalAlignment="Center"/>
              <TextBox x:Name="ExefsPath" Grid.Column="1" Style="{StaticResource Path}"/>
              <Button x:Name="BrowseC" Grid.Column="2" Style="{StaticResource Quiet}" Height="38" Margin="8,0,0,0"/>
            </Grid>
          </StackPanel>
          <Grid Margin="1,10,0,0" MinHeight="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Rectangle x:Name="CheckMark" Style="{StaticResource Diamond}" VerticalAlignment="Top" Margin="0,6,12,0"/>
            <TextBlock x:Name="CheckText" Grid.Column="1" Style="{StaticResource Small}"/>
          </Grid>

          <t:Caps x:Name="SaveToLabel" Style="{StaticResource FieldLabel}" Margin="0,22,0,10"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="OutPath" Style="{StaticResource Path}"/>
            <Button x:Name="BrowseD" Grid.Column="1" Style="{StaticResource Quiet}" Height="38" Margin="8,0,0,0"/>
          </Grid>
          <!-- (11-13) NVIDIA DLSS: off unless ticked; ticking asks for NVIDIA's license first (Shell.cs DlssTick) -->
          <CheckBox x:Name="DlssTick" Style="{StaticResource Tick}" Margin="0,14,0,0"
                    Content="NVIDIA DLSS for RTX cards (downloads NVIDIA's DLSS files, about 60 MB)"/>
        </StackPanel>

        <Grid Grid.Row="3">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="SpaceText" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,20,0"/>
          <!-- (11-13: back to the page this one was opened from, when there is a game to go back to) -->
          <Button x:Name="SetupBack" Grid.Column="1" Style="{StaticResource Quiet}" Height="44" Margin="0,0,12,0" Visibility="Collapsed"/>
          <Button x:Name="BuildButton" Grid.Column="2" Style="{StaticResource Primary}" IsEnabled="False"/>
        </Grid>
      </Grid>

      <!-- page: building (its details take the whole width when shown: Shell lets the page span both columns) -->
      <Grid x:Name="BuildPage" Grid.Row="1" Margin="56,22,34,36" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Rectangle Width="20" Height="1" Fill="{StaticResource LineGoldHi}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <t:Caps x:Name="BuildEyebrow" Label="III · Forge" Style="{StaticResource Eyebrow}"/>
          </StackPanel>
          <TextBlock x:Name="BuildTitle" Style="{StaticResource Title}"/>
          <TextBlock x:Name="BuildNote" Style="{StaticResource Body}" Margin="0,12,0,0" MaxWidth="900"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,30,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="StageColumn" Width="540"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel x:Name="StageList" VerticalAlignment="Top"/>
          <TextBox x:Name="Log" Grid.Column="1" Margin="26,0,0,0" Visibility="Collapsed" IsReadOnly="True" BorderThickness="1"
                   BorderBrush="{StaticResource Line}" Background="#E60C0B09" Foreground="{StaticResource TextDim}"
                   FontFamily="{StaticResource Mono}" FontSize="11.5" Padding="12,10" VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FocusVisualStyle="{x:Null}"/>
        </Grid>
        <Grid Grid.Row="2" Height="44">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ToggleButton x:Name="ShowLog" Style="{StaticResource Link}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="OpenButton" Style="{StaticResource Quiet}" Height="44" Visibility="Collapsed" Margin="0,0,12,0"/>
            <Button x:Name="BackButton" Style="{StaticResource Quiet}" Height="44" Visibility="Collapsed"/>
            <Button x:Name="CancelButton" Style="{StaticResource Quiet}" Height="44"/>
            <Button x:Name="PlayButton" Style="{StaticResource Primary}" Visibility="Collapsed"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>

    <!-- a question that must be answered before anything else (closing while a build runs) -->
    <Grid x:Name="AskLayer" Visibility="Collapsed" Background="#D9060504">
      <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="2" Padding="34,30,34,28"
              Background="#0E0C0A" BorderBrush="{StaticResource LineGold}" BorderThickness="1">
        <StackPanel>
          <Rectangle Style="{StaticResource Diamond}" HorizontalAlignment="Left" Fill="{StaticResource Gold300}" Margin="1,0,0,16"/>
          <TextBlock x:Name="AskText" Style="{StaticResource Title}" FontSize="24" LineHeight="30" Margin="0"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
            <Button x:Name="AskNo" Style="{StaticResource Quiet}" Height="40" Margin="0,0,12,0"/>
            <Button x:Name="AskYes" Style="{StaticResource Primary}" Height="40" MinWidth="150"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- the window's edge, where Windows draws none of its own (Shell hides it when Windows 11 colours the frame) -->
    <Border x:Name="WindowEdge" BorderThickness="1" BorderBrush="#40361F" IsHitTestVisible="False"/>
  </Grid>
  </Grid>
</Window>
